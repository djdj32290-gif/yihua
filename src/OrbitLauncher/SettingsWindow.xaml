<Window x:Class="OrbitLauncher.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OrbitLauncher"
 Title="一划 · 设置" Width="1020" Height="800" MinWidth="760" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource Theme.Window}" Foreground="{DynamicResource Theme.TextStrong}" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/></Style>
  <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
  <Style TargetType="Button" BasedOn="{StaticResource ActionButton}"/>
  <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}"><Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="Margin" Value="0,10,0,10"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource Theme.List}"/><Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Selected}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.AccentHover}"/><Setter TargetName="Bd" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabItem">
   <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Foreground" Value="{DynamicResource Theme.Muted}"/><Setter Property="Padding" Value="20,10"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Selected}"/><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.SelectedBorder}"/><Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.Hover}"/></MultiTrigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Theme.AccentHover}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" IsItemsHost="True" Margin="0,0,0,18"/><ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="32,26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal"><Image Source="{x:Static local:Branding.Logo}" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="一划" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="YIHUA" Foreground="{DynamicResource Theme.AccentText}" FontSize="10" Margin="12,0,0,5" VerticalAlignment="Bottom"/></StackPanel><TextBlock Text="一划即达，让常用的入口就在手边。" Foreground="{DynamicResource Theme.Muted}" Margin="0,4,0,0" FontSize="11"/></StackPanel></StackPanel>
   <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><Border Background="{DynamicResource Theme.Status}" BorderBrush="{DynamicResource Theme.StatusBorder}" BorderThickness="1" CornerRadius="12" Padding="12,5"><TextBlock x:Name="RuntimeTrayStatus" FontSize="11" Foreground="{DynamicResource Theme.StatusText}"/></Border><TextBlock x:Name="VersionLabel" HorizontalAlignment="Right" Foreground="{DynamicResource Theme.Subtle}" FontSize="10" Margin="0,7,4,0"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="{DynamicResource Theme.Hint}" BorderBrush="{DynamicResource Theme.HintBorder}" BorderThickness="1" CornerRadius="10" Padding="15,11" Margin="0,21,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="GestureHint" Foreground="{DynamicResource Theme.HintText}" FontSize="12" VerticalAlignment="Center"/><Border Grid.Column="1" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="5" Padding="7,3" Margin="12,0,0,0" ToolTip="回到中心、提前松开修饰键或按 Esc 均可取消"><TextBlock Text="Esc 取消" Foreground="{DynamicResource Theme.Muted}" FontSize="10"/></Border></Grid></Border>
  <TabControl x:Name="SettingsTabs" Grid.Row="2">
   <TabItem Header="轮盘布局"><ScrollViewer x:Name="WheelScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border CornerRadius="16" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" Background="{DynamicResource Theme.Surface}" Padding="24,20" MinHeight="410" Height="{Binding ViewportHeight,ElementName=WheelScroller}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="你的快捷入口" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="WheelHint" Text="点击编辑  /  拖动交换  /  中心添加" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource Theme.Muted}"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><Border HorizontalAlignment="Right" Background="{DynamicResource Theme.Badge}" CornerRadius="7" Padding="10,6"><TextBlock x:Name="CountLabel" Foreground="{DynamicResource Theme.BadgeText}" FontSize="11"/></Border><WrapPanel HorizontalAlignment="Right" Margin="0,8,0,0"><Button x:Name="DeleteModeButton" Content="批量删除" Click="DeleteMode_Click" Padding="10,6" FontSize="11"/><Button x:Name="DeleteSelectedButton" Content="删除所选（0）" Click="DeleteSelected_Click" Visibility="Collapsed" IsEnabled="False" Padding="10,6" FontSize="11" Margin="8,0,0,0" Background="{DynamicResource Theme.DangerBackground}" BorderBrush="{DynamicResource Theme.DangerBorder}" Foreground="{DynamicResource Theme.DangerText}"/></WrapPanel></StackPanel></Grid>
    <Viewbox Grid.Row="1" Margin="0,12,0,10" Stretch="Uniform" MaxWidth="620"><local:RadialSurface x:Name="WheelPreview" Width="452" Height="452" EditorMode="True" AutomationProperties.Name="轮盘预览：点击选项编辑，中心加号添加"/></Viewbox>
    <StackPanel Grid.Row="2" HorizontalAlignment="Center"><WrapPanel HorizontalAlignment="Center" Margin="0,0,0,9">
     <StackPanel Orientation="Horizontal" Margin="0,0,22,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource Theme.CategoryWeb}" Margin="0,0,7,0"/><TextBlock Text="网页" Foreground="{DynamicResource Theme.CategoryWeb}" FontSize="12"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,22,0" ToolTip="exe、快捷方式和脚本"><Ellipse Width="8" Height="8" Fill="{DynamicResource Theme.CategoryApplication}" Margin="0,0,7,0"/><TextBlock Text="应用" Foreground="{DynamicResource Theme.CategoryApplication}" FontSize="12"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,22,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource Theme.CategoryFolder}" Margin="0,0,7,0"/><TextBlock Text="文件夹" Foreground="{DynamicResource Theme.CategoryFolder}" FontSize="12"/></StackPanel>
     <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource Theme.CategoryFile}" Margin="0,0,7,0"/><TextBlock Text="文件" Foreground="{DynamicResource Theme.CategoryFile}" FontSize="12"/></StackPanel>
    </WrapPanel><TextBlock Text="预览中的点击只用于编辑；实际手势轮盘的中心仍是取消区。" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource Theme.Muted}" TextWrapping="Wrap"/></StackPanel>
   </Grid></Border></ScrollViewer></TabItem>
   <TabItem Header="手势与外观"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,0,6,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="254"/></Grid.ColumnDefinitions>
    <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,20"><TextBlock Text="手势与外观" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="调整一次，整个轮盘立即生效。" Foreground="{DynamicResource Theme.Muted}" Margin="0,5,0,0"/></StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource Theme.Card}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,16,0" VerticalAlignment="Top"><StackPanel>
     <DockPanel Margin="0,0,0,6"><TextBlock Text="界面配色" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Width="180" HorizontalAlignment="Right" SelectedValuePath="Id" SelectionChanged="Theme_Changed" AutomationProperties.Name="界面配色"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Background="{Binding PreviewBackground}" BorderBrush="{Binding PreviewAccent}" BorderThickness="1" CornerRadius="4" Width="22" Height="18" Margin="0,0,9,0"><Ellipse Fill="{Binding PreviewAccent}" Width="7" Height="7"/></Border><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></DockPanel>
     <TextBlock x:Name="ThemeHint" Foreground="{DynamicResource Theme.Muted}" FontSize="11" Margin="0,2,0,16" TextWrapping="Wrap"/>
     <DockPanel><TextBlock Text="触发修饰键" VerticalAlignment="Center"/><ComboBox x:Name="ModifierBox" Width="150" HorizontalAlignment="Right" SelectionChanged="Modifier_Changed"><ComboBoxItem Content="左 Alt"/><ComboBoxItem Content="左 Ctrl"/><ComboBoxItem Content="左 Shift"/></ComboBox></DockPanel>
     <TextBlock Text="只响应所选的左侧按键，右 Alt / AltGr 不触发。" Foreground="{DynamicResource Theme.Subtle}" FontSize="11" Margin="0,10,0,10"/>
     <TextBlock x:Name="SizeLabel" Margin="0,14,0,8"/><Slider x:Name="SizeSlider" Minimum="300" Maximum="680" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Appearance_Changed"/>
     <TextBlock x:Name="CancelLabel" Margin="0,20,0,8"/><Slider x:Name="CancelSlider" Minimum="28" Maximum="110" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="Appearance_Changed"/>
     <TextBlock x:Name="ThresholdLabel" Margin="0,20,0,8"/><Slider x:Name="ThresholdSlider" Minimum="4" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Appearance_Changed"/>
    </StackPanel></Border>
    <StackPanel Grid.Row="1" Grid.Column="1"><Border Background="{DynamicResource Theme.Card}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="后台运行" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/><CheckBox x:Name="StartupCheck" Content="开机自启动" Click="Startup_Click"/><TextBlock Text="登录 Windows 后自动在托盘运行。" Foreground="{DynamicResource Theme.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/><CheckBox x:Name="PauseCheck" Content="暂时停用手势" Click="Pause_Click"/><TextBlock Text="也可以在托盘右键菜单中切换。" Foreground="{DynamicResource Theme.Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,16,0,0"><Expander Header="运行诊断" IsExpanded="False" Foreground="{DynamicResource Theme.Muted}"><StackPanel><TextBlock x:Name="RuntimeInputStatus" Margin="0,12,0,0" Foreground="{DynamicResource Theme.Muted}" TextWrapping="Wrap" FontSize="11"/><Button x:Name="ExportDiagnosticsButton" Content="导出诊断" Click="ExportDiagnostics_Click" Margin="0,12,0,0" Padding="10,6" HorizontalAlignment="Left"/><TextBlock x:Name="DiagnosticExportStatus" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,0"/></StackPanel></Expander></Border>
    </StackPanel>
   </Grid></ScrollViewer></TabItem>
   <TabItem Header="游戏保护"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,14"><TextBlock Text="游戏与应用保护" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="GameModeCheck" Content="游戏模式：右侧名单中的应用在前台时停用手势" Click="Protection_Click" Margin="0,10,0,6"/><TextBlock Text="窗口模式同样生效。双击左侧程序移入右侧名单，切回桌面后自动恢复。" Foreground="{DynamicResource Theme.Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="{DynamicResource Theme.Card}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="11" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12"><Button x:Name="RefreshRunningButton" Content="刷新" DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="10,6" Click="RefreshRunningApps_Click"/><TextBlock x:Name="RunningCount" Text="运行中的程序" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <Grid Grid.Row="1"><ListBox x:Name="RunningAppsList" MouseDoubleClick="RunningApps_DoubleClick" AutomationProperties.Name="待加入的运行程序，双击移入保护名单"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="26" Height="26" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Theme.Muted}" FontSize="10.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="RunningEmpty" Text="没有待加入的运行程序" Foreground="{DynamicResource Theme.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
      <TextBlock Grid.Row="2" Text="双击移入名单 · 已加入的程序在右侧显示" Foreground="{DynamicResource Theme.Muted}" FontSize="10.5" Margin="0,10,0,0"/>
     </Grid></Border>
     <Button x:Name="AddRunningAppButton" Grid.Column="1" Content="加入 →" Click="AddRunningApp_Click" Padding="10,10" Margin="10,0" VerticalAlignment="Center"/>
     <Border Grid.Column="2" Background="{DynamicResource Theme.Card}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" CornerRadius="11" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="ProtectedCount" Text="保护名单" FontWeight="SemiBold" Margin="0,7,0,19"/>
      <ListBox x:Name="BlockedAppList" Grid.Row="1" AutomationProperties.Name="游戏保护名单"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="26" Height="26" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="5,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <WrapPanel Grid.Row="2" Margin="0,10,0,0"><Button Content="选择应用 exe" Click="AddAppFile_Click" Padding="11,7" Margin="0,0,8,0"/><Button x:Name="RemoveAppButton" Content="移除所选" Click="RemoveApp_Click" Padding="11,7"/></WrapPanel>
     </Grid></Border>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,10,0,0"><CheckBox x:Name="FullscreenCheck" Content="同时在其它全屏应用前台停用手势" Click="Protection_Click" Margin="0,6,0,7"/><TextBlock Text="预置 LOL；无法识别应用身份时暂停本次手势。托盘菜单可临时停用全部手势。" Foreground="{DynamicResource Theme.Muted}" FontSize="11" TextWrapping="Wrap"/></StackPanel>
   </Grid></TabItem>
  </TabControl>
  <Border Grid.Row="3" BorderBrush="{DynamicResource Theme.Button}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,20,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SaveStatus" Text="点击轮盘开始编辑，设置保存在本机。" Foreground="{DynamicResource Theme.Muted}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,18,0"/><Button Grid.Column="1" Content="退出一划" Click="Exit_Click" Margin="0,0,10,0" Background="Transparent" BorderBrush="{DynamicResource Theme.Border}"/><Button x:Name="SaveCloseButton" Grid.Column="2" Content="保存并关闭设置" Click="Done_Click" Background="{DynamicResource Theme.Accent}" Foreground="{DynamicResource Theme.OnAccent}" BorderBrush="{DynamicResource Theme.AccentHover}" FontWeight="SemiBold"/></Grid></Border>
 </Grid>
</Window>
