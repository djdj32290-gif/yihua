<Window x:Class="OrbitLauncher.RunningApplicationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="从运行中的程序添加" Width="700" Height="620" MinWidth="580" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Theme.Window}" Foreground="{DynamicResource Theme.Text}" FontFamily="Microsoft YaHei UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
  <Style TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="4,3"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Theme.Hover}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Theme.Selected}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Theme.SelectedBorder}"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="运行中的程序" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextStrong}"/><TextBlock Text="选择一个已打开的应用，双击即可填入选项详情。" Margin="0,7,0,0" Foreground="{DynamicResource Theme.Muted}" TextWrapping="Wrap"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,12"><Button Content="刷新" DockPanel.Dock="Right" Click="Refresh_Click" Margin="10,0,0,0"/><Grid><TextBox x:Name="SearchBox" Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Center" ToolTip="搜索程序名称、窗口标题或路径" AutomationProperties.Name="搜索运行中的程序" TextChanged="Search_Changed"/><TextBlock Text="搜索名称、窗口标题或路径" Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource Theme.Subtle}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></DockPanel>
  <Grid Grid.Row="2">
   <ListBox x:Name="ApplicationsList" Background="{DynamicResource Theme.List}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="Selection_Changed" MouseDoubleClick="Application_DoubleClick" KeyDown="Application_KeyDown" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
    <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Theme.TextStrong}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding WindowTitle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.Muted}"/><TextBlock Text="{Binding Path}" Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Theme.Subtle}"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock x:Name="EmptyState" Text="没有可添加的运行程序。请先打开应用，再点击刷新。" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" TextWrapping="Wrap" Foreground="{DynamicResource Theme.Muted}" IsHitTestVisible="False" Visibility="Collapsed"/>
  </Grid>
  <StackPanel Grid.Row="3" Margin="0,10,0,12"><TextBlock x:Name="ListStatus" Foreground="{DynamicResource Theme.Muted}" TextWrapping="Wrap"/><TextBlock x:Name="ErrorStatus" Foreground="{DynamicResource Theme.Validation}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/></StackPanel>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" IsCancel="True" Margin="0,0,10,0" Click="Cancel_Click"/><Button x:Name="UseButton" Content="使用此程序" IsDefault="True" IsEnabled="False" Click="Use_Click" Background="{DynamicResource Theme.Accent}" Foreground="{DynamicResource Theme.OnAccent}" BorderBrush="{DynamicResource Theme.AccentHover}"/></StackPanel>
 </Grid>
</Window>
